# ReadyAgents BYOK — copy to .env and fill in your keys.
# Never commit real keys. See docs/configuration.md.

# Default model: provider:model
# Examples: openai:gpt-4o-mini  anthropic:claude-sonnet-4-5  openai-compat:llama-3.1-8b-instant
READYAGENTS_DEFAULT_MODEL=openai:gpt-4o-mini

# OpenAI (or set READYAGENTS_OPENAI_API_KEY)
OPENAI_API_KEY=

# Anthropic (or set READYAGENTS_ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=

# Optional extras (not in [all]): Gemini, Bedrock, Vertex
# GEMINI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# VERTEX_PROJECT=
# VERTEX_LOCATION=us-central1
# READYAGENTS_CAPABILITY_MATRIX=

# OpenAI-compatible providers (Groq, Ollama, Together, etc.)
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# READYAGENTS_OPENAI_COMPAT_API_KEY=
# READYAGENTS_OPENAI_COMPAT_BASE_URL=

# Opt-in outbound HTTP for the builtin http_get tool
# READYAGENTS_ALLOW_HTTP=0

# Workspace root for sandboxed read_file / write_file (defaults to the workflow file's directory)
# READYAGENTS_WORKSPACE=

# Run artifact directory (defaults to .readyagents in cwd)
# READYAGENTS_HOME=.readyagents

# Logging: DEBUG, INFO, WARNING, ERROR
# READYAGENTS_LOG_LEVEL=INFO
# READYAGENTS_LOG_FORMAT=text

# Optional cost / fallback / cache / redaction (all off by default)
# READYAGENTS_MAX_TOKENS=
# READYAGENTS_MAX_COST_USD=
# READYAGENTS_FALLBACK_MODELS=
# READYAGENTS_LLM_CACHE=0
# READYAGENTS_REDACT=0
# READYAGENTS_ACTOR=
# READYAGENTS_PAUSE_NOTIFY_URL=
