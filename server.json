{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.readyagentsdev/readyagents",
  "title": "ReadyAgents",
  "description": "Local YAML/JSON agent workflow CLI with approvals, resume, and optional stdio or loopback MCP HTTP.",
  "repository": {
    "url": "https://github.com/readyagentsdev/readyagents-core",
    "source": "github"
  },
  "version": "1.7.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "readyagentsdev",
      "version": "1.7.0",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
